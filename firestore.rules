rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/userProfiles/$(uid);
    }

    function usernamePath(username) {
      return /databases/$(database)/documents/usernames/$(username);
    }

    function hasCompletedProfile() {
      return signedIn() && exists(userProfilePath(request.auth.uid));
    }

    function validRealName(value) {
      return value is string && value.size() >= 2 && value.size() <= 60
        && value.matches('^[^<>]{2,60}$');
    }

    function validUsername(value) {
      return value is string && value.matches('^[a-z0-9_]{3,20}$');
    }

    function validProfileDocument() {
      return request.resource.data.keys().hasAll([
          'realName', 'username', 'usernameLower', 'provider', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'realName', 'username', 'usernameLower', 'provider', 'createdAt'
        ])
        && validRealName(request.resource.data.realName)
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username
        && request.resource.data.provider in ['password', 'google.com', 'facebook.com']
        && request.resource.data.createdAt == request.time
        && getAfter(usernamePath(request.resource.data.usernameLower)).data.uid == request.auth.uid;
    }

    function rateLimitPath(uid) {
      return /databases/$(database)/documents/wallRateLimits/$(uid);
    }

    // One wall action (post or report) per account every 20 seconds.
    function cooldownPassed(uid) {
      let path = rateLimitPath(uid);
      return !exists(path)
        || get(path).data.lastSentAt < request.time - duration.value(20, 's');
    }

    function hasMatchingRateLimitWrite(actionId) {
      let path = rateLimitPath(request.auth.uid);
      return getAfter(path).data.lastActionId == actionId
        && getAfter(path).data.lastSentAt == request.time;
    }

    function validRateLimitDocument() {
      return request.resource.data.keys().hasAll(['lastSentAt', 'lastActionId'])
        && request.resource.data.keys().hasOnly(['lastSentAt', 'lastActionId'])
        && request.resource.data.lastSentAt == request.time
        && request.resource.data.lastActionId is string
        && request.resource.data.lastActionId.size() <= 40;
    }

    // Private user profile: only the owner can read it. The real name is never public.
    match /userProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid && validProfileDocument();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['realName'])
        && validRealName(request.resource.data.realName)
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // A username claim stores only the Firebase UID, never the email or real name.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(usernamePath(username))
        && getAfter(userProfilePath(request.auth.uid)).data.usernameLower == username;
      allow update, delete: if false;
    }

    match /wallMessages/{messageId} {
      // Visitors can read the public wall. Only accounts with completed profiles can post.
      allow get, list: if true;
      allow create: if hasCompletedProfile()
        && request.resource.data.keys().hasAll(['message', 'category', 'createdAt'])
        && request.resource.data.keys().hasOnly(['message', 'category', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 4
        && request.resource.data.message.size() <= 150
        && request.resource.data.category is string
        && request.resource.data.category in [
          'Lời động viên', 'Lời cảm ơn', 'Điều tích cực', 'Cam kết tử tế'
        ]
        && request.resource.data.createdAt == request.time
        && cooldownPassed(request.auth.uid)
        && hasMatchingRateLimitWrite(messageId);
      allow update, delete: if false;
    }

    match /wallReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if hasCompletedProfile()
        && request.resource.data.keys().hasAll(['messageId', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['messageId', 'reason', 'createdAt'])
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() <= 40
        && exists(/databases/$(database)/documents/wallMessages/$(request.resource.data.messageId))
        && request.resource.data.reason == 'inappropriate'
        && request.resource.data.createdAt == request.time
        && cooldownPassed(request.auth.uid)
        && hasMatchingRateLimitWrite(reportId);
    }

    match /wallRateLimits/{uid} {
      allow read, delete: if false;
      allow create, update: if hasCompletedProfile()
        && request.auth.uid == uid
        && validRateLimitDocument()
        && cooldownPassed(uid)
        && (
          existsAfter(/databases/$(database)/documents/wallMessages/$(request.resource.data.lastActionId))
          || existsAfter(/databases/$(database)/documents/wallReports/$(request.resource.data.lastActionId))
        );
    }
  }
}
